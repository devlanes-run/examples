{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "devlanes __agent-hook --agent claude-code; exit 0",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ]
  }
}
