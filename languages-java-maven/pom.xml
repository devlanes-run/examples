<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- The Spring Boot version every module uses, and the only place it is written. -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>com.acme</groupId>
  <artifactId>java-maven</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>

  <modules>
    <module>shared</module>
    <module>quotes</module>
    <module>web</module>
  </modules>

  <properties>
    <java.version>21</java.version>
  </properties>

  <build>
    <plugins>
      <!--
        `-pl web -am spring-boot:run` runs the goal on every module it builds, this parent and
        shared included. Skipping it here and turning it back on in the apps keeps run and
        repackage to quotes and web.
      -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
