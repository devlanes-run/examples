{
  "name": "@mprocs-migration/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --conditions=development src/scripts/migrate.ts",
    "db:seed": "tsx --conditions=development src/scripts/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "@mprocs-migration/shared": "*",
    "@mprocs-migration/store": "*",
    "hono": "4.13.16"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
