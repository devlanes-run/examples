{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "noEmit": true,
    // Node runs these files itself, stripping the types, so imports name the .mts files.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["metro.config.mts", "devserver", "scripts"]
}
